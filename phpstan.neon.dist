includes:
	- phpstan-baseline.neon
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5

	# The plugin supports PHP 8.0 upwards, so analyse against the lowest
	# supported version — anything newer would let 8.1+ syntax slip through.
	# PHPCompatibility 9.x has no 8.1+ sniffs and silently passes constructs
	# like `readonly` properties or `never` return types, so phpcs alone
	# cannot enforce the 8.0 floor; this phpVersion pin is what actually does.
	phpVersion:
		min: 80000
		max: 80599

	paths:
		- lw-translate.php
		- includes/

	excludePaths:
		- tests/
		- vendor/

	# Declare the plugin's runtime-defined constants for static analysis.
	bootstrapFiles:
		- phpstan-bootstrap.php

	# Third-party APIs the plugin integrates with. WordPress core stubs come
	# from the szepeviktor/phpstan-wordpress extension above.
	#
	# wp-cli-tools-stubs.php declares cli\progress\Bar (returned by
	# WP_CLI\Utils\make_progress_bar()) — that class is provided by the
	# wp-cli/php-cli-tools package WP-CLI bundles at runtime, and this stub
	# file (shipped inside php-stubs/wp-cli-stubs, already a dev dependency)
	# is what lets PHPStan resolve tick()/finish() on it.
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php

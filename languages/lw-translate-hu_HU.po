#: includes/SiteManager/Integration.php:39
msgid "Translation management abilities"
msgstr "Fordításkezelési képességek"

#: includes/SiteManager/TranslateAbilities.php:42
msgid "List Translations"
msgstr "Fordítások listázása"

#: includes/SiteManager/TranslateAbilities.php:43
msgid ""
"List installed translations and their update status for all plugins and "
"themes."
msgstr ""
"A telepített fordítások és frissítési állapotuk listázása minden "
"bővítményhez és sablonhoz."

#: includes/SiteManager/TranslateAbilities.php:54
msgid "Filter by type: plugin, theme, or all (default)."
msgstr "Szűrés típus szerint: plugin, theme vagy all (alapértelmezett)."

#: includes/SiteManager/TranslateAbilities.php:59
msgid "Filter by status: up_to_date, update, not_installed, or all (default)."
msgstr ""
"Szűrés állapot szerint: up_to_date, update, not_installed vagy all "
"(alapértelmezett)."

#: includes/SiteManager/TranslateAbilities.php:89
msgid "Get Translate Options"
msgstr "Translate beállítások lekérése"

#: includes/SiteManager/TranslateAbilities.php:90
msgid "Get LW Translate plugin settings (locale, tone, cache TTL)."
msgstr ""
"Az LW Translate bővítmény beállításainak lekérése (nyelv, hangnem, "
"gyorsítótár élettartama)."

#: includes/SiteManager/TranslateAbilities.php:122
msgid "Install Translation"
msgstr "Fordítás telepítése"

#: includes/SiteManager/TranslateAbilities.php:123
msgid "Install or update a translation for a specific plugin or theme."
msgstr ""
"Egy adott bővítmény vagy sablon fordításának telepítése vagy frissítése."


msgid "Update All Translations"
msgstr "Összes fordítás frissítése"

#: includes/SiteManager/TranslateAbilities.php:171
msgid "Update all translations that have a newer version available."
msgstr "Minden olyan fordítás frissítése, amelyhez újabb verzió érhető el."

#: includes/SiteManager/TranslateService.php:92
msgid "Both slug and type are required."
msgstr "Az azonosító (slug) és a típus is kötelező."

#: includes/SiteManager/TranslateService.php:100
msgid "Type must be plugin or theme."
msgstr "A típus csak plugin vagy theme lehet."

#. translators: 1: plugin/theme type, 2: slug
#: includes/SiteManager/TranslateService.php:117
#, php-format
msgid "Translation installed for %1$s %2$s."
msgstr "Fordítás telepítve: %1$s %2$s."

